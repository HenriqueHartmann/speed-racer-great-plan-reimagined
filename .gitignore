# =============================================================================
# The repository owner has decided to track the original artifact and the
# material derived from it, so that the project can be cloned and run on their
# own machines. See README.md for what that means and the risk it carries.
#
# Original files are still never moved, renamed or modified in place.
#
# Staging remains by explicit path. `git add .` and `git add -A` are still not
# used, so that every addition is a deliberate one.
# =============================================================================

# -- Native modules and OS binaries we never want ------------------------------
*.so
*.dylib
*.x32

# -- Node / build output (nothing installed yet; present for later stages) -----
node_modules/
dist/
build/
.vite/
coverage/
*.tsbuildinfo

# -- Test and tooling output --------------------------------------------------
playwright-report/
test-results/
.vitest/

# -- Environment and secrets --------------------------------------------------
.env
.env.*
!.env.example

# -- Editor and OS noise ------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# -- Python bytecode ----------------------------------------------------------
__pycache__/
*.pyc

# -- Python bytecode ----------------------------------------------------------
__pycache__/
*.pyc
